   <patchobj type="patch/object" uuid="44f0a359-b13a-4fa5-8b0a-a4bd9ea2077d" name="tx_36n" x="280" y="280">
      <params/>
      <attribs>
         <spinner attributeName="note" value="36"/>
      </attribs>
      <object id="patch/object" uuid="44f0a359-b13a-4fa5-8b0a-a4bd9ea2077d">
         <sDescription>transmit a midi note with companion &apos;midiout_1&apos; object</sDescription>
         <author></author>
         <license></license>
         <helpPatch>mux.axh</helpPatch>
         <inlets>
            <bool32 name="midi" description="input 1"/>
         </inlets>
         <outlets/>
         <displays/>
         <params/>
         <attribs>
            <spinner name="note" MinValue="36" MaxValue="38" DefaultValue="36"/>
         </attribs>
         <includes/>
         <code.declaration><![CDATA[int krate_trig;
int midi_ntrig;]]></code.declaration>
         <code.init><![CDATA[krate_trig = midi_ntrig = 0; // 0=idle, 1=active]]></code.init>
         <code.krate><![CDATA[krate_trig = inlet_midi;
if ((krate_trig>0) && !midi_ntrig) {
 // on, note=60, velo=100
 instancemidiout__1::tx3Byte( MIDI_NOTE_ON + MIDICHANNEL, attr_note, 100 ); //MidiSend3...
 
 midi_ntrig=1;
}
if (!(krate_trig>0) && midi_ntrig) {
 // off, note=60, velo=0
 instancemidiout__1::tx3Byte( MIDI_NOTE_OFF + MIDICHANNEL, attr_note, 0 ); //MidiSend3...
 
 midi_ntrig=0;
}]]></code.krate>
      </object>
   </patchobj>
   <comment type="patch/comment" x="42" y="420" text="8pots 2tog for MAUD"/>
   <comment type="patch/comment" x="42" y="448" text="panel objects must be the LOWEST objects in the java patch editor"/>
   <comment type="patch/comment" x="42" y="462" text="- these interact with each other using hacky-kludgy-API stuff"/>
   <comment type="patch/comment" x="420" y="462" text="must use firmware 3BBA8761"/>
   <comment type="patch/comment" x="686" y="462" text="soft-thru delete as appropriate"/>
   <comment type="patch/comment" x="42" y="476" text="- so make sure they appear in order [LCD][Control][Midi][Assign]"/>
   <comment type="patch/comment" x="420" y="476" text="for stable midi system exclusive"/>
   <patchobj type="patch/object" uuid="ded95048-2999-41a3-9e7c-7d58dc857ab8" name="midithru_1" x="686" y="476">
      <params/>
      <attribs>
         <combo attributeName="src" selection=" USB_PROG"/>
         <combo attributeName="dst" selection=" USB_HOST"/>
      </attribs>
      <object id="patch/object" uuid="ded95048-2999-41a3-9e7c-7d58dc857ab8">
         <sDescription>soft midi thru, from specific SRC to specific dest with built-in MidiSend...() funcs</sDescription>
         <author>zenpho</author>
         <inlets/>
         <outlets/>
         <displays/>
         <params/>
         <attribs>
            <combo name="src" description="listen for messages on this port">
               <MenuEntries>
                  <string>DIN</string>
                  <string> USB_PROG</string>
                  <string> USB_HOST</string>
               </MenuEntries>
               <CEntries>
                  <string>MIDI_DEVICE_DIN</string>
                  <string> MIDI_DEVICE_USB_DEVICE</string>
                  <string> MIDI_DEVICE_USB_HOST</string>
               </CEntries>
            </combo>
            <combo name="dst" description="transmit messages to this port">
               <MenuEntries>
                  <string>DIN</string>
                  <string> USB_PROG</string>
                  <string> USB_HOST</string>
               </MenuEntries>
               <CEntries>
                  <string>MIDI_DEVICE_DIN</string>
                  <string> MIDI_DEVICE_USB_DEVICE</string>
                  <string> MIDI_DEVICE_USB_HOST</string>
               </CEntries>
            </combo>
         </attribs>
         <includes/>
         <code.midihandler><![CDATA[static uint8_t syx[3] = {0,0,0}; // init blank
static int syx_progress = 0;     // init invalid
if( dev != attr_src ) return;    // do not proceed

if( syx_progress )
  {
  	syx[0]=status; syx[1]=data1; syx[2]=data2;
  	MidiSendSysEx( (midi_device_t)attr_dst, 1, syx, 3 );
  	
	if( 0xF7==status || 0xF7==data1 || 0xF7==data2 ) syx_progress = 0;
     else                                             syx_progress = 1;
     
     return;
  }

  switch( status&0xF0 ){
	case 0x80:
	case 0x90:
	case 0xA0:
	case 0xB0:
	case 0xE0:
		MidiSend3( (midi_device_t)attr_dst, 1, status, data1, data2 );
		break;

	case 0xC0:
	case 0xD0:
		MidiSend2( (midi_device_t)attr_dst, 1, status, data1 );
		break;

	case 0xF0:
	     if( 0xF7!=status && 0xF0!=status ){ MidiSend1( (midi_device_t)attr_dst, 1, status ); }
	     else {
            syx[0]=status; syx[1]=data1; syx[2]=data2;
  		  MidiSendSysEx( (midi_device_t)attr_dst, 1, syx, 3 );

            if( 0xF7==status || 0xF7==data1 || 0xF7==data2 ) syx_progress = 0;
            else                                             syx_progress = 1;
	     }
          break;

	default:
		break;
  }]]></code.midihandler>
      </object>
   </patchobj>
