		MidiSend2( (midi_device_t)attr_dst, 1, status, data1 );
		break;

	case 0xF0:
	     if( 0xF7!=status && 0xF0!=status ){ MidiSend1( (midi_device_t)attr_dst, 1, status ); }
	     else {
            syx[0]=status; syx[1]=data1; syx[2]=data2;
  		  MidiSendSysEx( (midi_device_t)attr_dst, 1, syx, 3 );

            if( 0xF7==status || 0xF7==data1 || 0xF7==data2 ) syx_progress = 0;
            else                                             syx_progress = 1;
